# FORERUN Android Release Keystore Configuration
# -------------------------------------------------------------
# Instructions:
# 1. Copy this file to 'keystore.properties' in this directory (or in 'app/keystore.properties')
# 2. Update the values below with your actual keystore details
# 3. Keep 'keystore.properties' and your *.jks files private and NEVER commit them to Git!
# -------------------------------------------------------------

# Path to the keystore file (relative to app/ directory or absolute path)
# Example: release.jks (if placed in app/) or ../forerun-release.jks (if placed in apps/android/)
storeFile=release.jks

# Password for the keystore
storePassword=your_keystore_password

# Alias of the signing key
keyAlias=forerun_release

# Password for the key
keyPassword=your_key_password
